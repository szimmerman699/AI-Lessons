# Document Analyzer Configuration
# Copy this file to .env and fill in with your actual values
# Never commit .env to version control

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# API Configuration (for future external integrations)
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3

# File Processing
MAX_FILE_SIZE_MB=50
ALLOWED_FORMATS=pdf,docx,txt

# External Service API Keys (never commit these)
# LANGUAGE_API_KEY=your_key_here
# DOCUMENT_PROCESSING_API_KEY=your_key_here
